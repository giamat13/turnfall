<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon artwork, set inside a 20 dp margin so the launcher's mask never cuts the board. The background
     layer is the same blue as the artwork's edge, so the margin does not show. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/app_icon_art"
    android:insetLeft="20dp"
    android:insetTop="20dp"
    android:insetRight="20dp"
    android:insetBottom="20dp" />
